{
  "manifest_version": 3,
  "name": "PrepInterview Copilot - Job Match & Interview Prep (Beta)",
  "version": "1.0.6",
  "description": "See resume skill match, experience, and requirement fit on LinkedIn jobs, and practice tailored interview questions in one click.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PrepInterview Copilot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "scripts/data/skills.js",
        "scripts/data/taxonomy.js",
        "scripts/data/colleges.js",
        "scripts/data/selectors.js",
        "scripts/scoring-config.js",
        "scripts/release-config.js",
        "scripts/matcher.js",
        "scripts/card-renderer.js",
        "scripts/content.js"
      ],
      "css": [
        "scripts/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
