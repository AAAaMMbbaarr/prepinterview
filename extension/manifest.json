{
  "manifest_version": 3,
  "name": "PrepInterview Copilot - LinkedIn Job Match & AI Mock Prep",
  "version": "1.0.5",
  "description": "See your real-time Resume Skill Match, Experience, Location & Education fit on LinkedIn Jobs and launch instant AI mock interview practice in 1 click.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PrepInterview Copilot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "scripts/data/skills.js",
        "scripts/data/taxonomy.js",
        "scripts/data/colleges.js",
        "scripts/data/selectors.js",
        "scripts/scoring-config.js",
        "scripts/matcher.js",
        "scripts/content.js"
      ],
      "css": [
        "scripts/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
